{
  "manifest_version": 3,
  "name": "Shipment Tracking Extension",
  "version": "1.1",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.msc.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://www.msc.com/*"],
      "js": ["carriers/msc_injector.js"]
    }
  ]
}