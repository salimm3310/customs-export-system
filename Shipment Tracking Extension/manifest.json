{
  "manifest_version": 3,
  "name": "Tracker Extension",
  "version": "1.0",
  "description": "إضافة التتبع الآلي للخطوط الملاحية",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}